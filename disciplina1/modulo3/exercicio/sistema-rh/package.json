{
  "name": "sistema-rh-match",
  "version": "1.0.0",
  "description": "Candidate and job matching project for an ML/RH exercise",
  "type": "module",
  "scripts": {
    "start": "npm run db:init && npm run start:all",
    "start:all": "concurrently -k -n api,web \"npm run start --prefix server\" \"browser-sync -w . --server --files index.html,style.css,data/*.json,src/**/*.js,src/**/*.html --port 3000\"",
    "db:init": "powershell -ExecutionPolicy Bypass -File ./infra/init-db.ps1",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "concurrently": "^9.0.1"
  }
}
